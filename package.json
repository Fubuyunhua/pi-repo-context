{
  "name": "pi-repo-context",
  "version": "0.1.0",
  "description": "Revision-aware repository indexing and code navigation extension for Pi",
  "type": "module",
  "license": "MIT",
  "author": "Fubuyunhua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fubuyunhua/pi-repo-context.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "repository-index",
    "code-navigation"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/index.ts",
    "src/extension.ts",
    "src/repo-map/canonical.ts",
    "src/repo-map/graph.ts",
    "src/repo-map/index.ts",
    "src/repo-map/java.ts",
    "src/repo-map/lexical-fallback.ts",
    "src/repo-map/runtime.ts",
    "src/repo-map/snapshot.ts",
    "src/state/atomic.ts",
    "src/state/config.ts",
    "src/state/owned-state.ts",
    "src/state/project-state.ts",
    "src/telemetry.ts",
    "vendor/tree-sitter-java-orchard/tree-sitter-java_orchard.wasm",
    "vendor/tree-sitter-java-orchard/LICENSE",
    "docs/MIGRATION.md",
    "docs/releases/v0.1.0.md",
    "docs/specs/0005-bounded-repo-map-generations.md",
    "docs/specs/0006-repo-map-file-outcomes.md",
    "docs/specs/0007-cached-repo-map-search.md",
    "docs/specs/0009-turn-start-snapshot-semantics.md",
    "docs/specs/0016-repository-graph-contract.md",
    "docs/specs/0019-lazy-repo-map-startup.md",
    "docs/specs/0020-cold-search-fallback.md",
    "docs/specs/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watcher": "vitest run tests/watcher-smoke.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:pi": "node scripts/pi-rpc-smoke.mjs",
    "test:cold-search": "node scripts/cold-first-search-surrogate.mjs",
    "ci": "npm run check && npm run test:coverage && npm run test:package && npm run test:cold-search"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "minisearch": "7.2.0",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.26.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "typebox": "1.3.7",
    "vitest": "4.1.10"
  }
}
